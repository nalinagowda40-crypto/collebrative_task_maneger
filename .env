PORT=5000
NODE_ENV=development

# Database configuration
# Set DB_DIALECT to 'postgres' for PostgreSQL, or 'sqlite' for quick local zero-config file database
DB_DIALECT=sqlite
DB_STORAGE=./dev_database.sqlite

# PostgreSQL configuration (when DB_DIALECT=postgres)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=collaborative_task_manager
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Security
JWT_SECRET=collaborative_task_manager_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Frontend URL
CLIENT_URL=http://localhost:5173
